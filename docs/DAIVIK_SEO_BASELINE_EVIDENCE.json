            {
              "@type": "FAQPage",
              "@id": "https://daivikborewells.com/#faq",
              "mainEntity": [
                {
                  "@type": "Question",
                  "name": "Can you reach a narrow road or an existing home?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Compact and track-mounted robo drilling machines may suit restricted sites. We check entrance width, turning space, overhead clearance and working room before confirming the right machine."
                  }
                },
                {
                  "@type": "Question",
                  "name": "How much does a borewell cost?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "The price depends on access, drilling depth, ground conditions, casing and pump requirements. Share your location and site details for an assessment and a scope-based quote."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Can you guarantee that we will find water?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "No. A groundwater assessment helps guide the drilling location, but water availability and yield depend on local geology. No survey or drilling method can guarantee water."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Do you handle casing and pump installation too?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes. We can coordinate assessment, machine selection, drilling, casing, pump installation and testing. Pump selection follows the drilling results and your usage requirements."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Can an existing borewell be deepened?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "We first assess the existing borewell, its condition and site access. Deepening is considered only where suitable; the recommendation and scope depend on that assessment."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Where in Bangalore do you work?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "We serve Thalaghattapura, Kanakapura Road, Uttarahalli, JP Nagar, Banashankari, Jayanagar and nearby South Bangalore areas. Share your location to confirm access and scheduling."
                  }
                },
                {
                  "@type": "Question",
                  "name": "How can I book a borewell site visit?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Call or WhatsApp Daivik Borewells on +91 94484 17318, email daivikborewells@gmail.com, or submit the site-visit form. Share your Bangalore location and property type so we can discuss access and the suitable drilling machine."
                  }
                }
              ]
            }
          ]
